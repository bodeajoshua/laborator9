@model dynamic

@{
    ViewData["Title"] = "Administrare";
}

<h1>Administrare</h1>

@if (TempData["Msg"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<p>Evaluări în baza de date: @ViewBag.Ratings</p>

<form asp-action="ImportRatings" method="post" enctype="multipart/form-data" class="mt-3">
    <div class="mb-3">
        <label for="file" class="form-label">Fișier CSV evaluări:</label>
        <input type="file" name="file" class="form-control" accept=".csv" />
    </div>
    <button type="submit" class="btn btn-primary">Importă evaluări</button>
</form>

<form asp-action="Retrain" method="post" class="mt-3">
    <button type="submit" class="btn btn-warning">Reantrenează modelul de recomandare</button>
</form>